rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows anyone with your Firestore database reference to view, edit,
    // and delete all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules

		// health check
    match /_status_/ping {
      allow read: if true; 
    }

    // Users Collection Configuration
    match /users/{userid} {
      // Allows individual document fetches AND queries (getProfileByUsername)
      allow read, get, list: if true; 
      
      // Only the owner can write to their public profile
      allow write: if request.auth != null && request.auth.uid == userid;

      // Secure Private Subcollection
      match /private/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userid;
      }
      
      // Links Subcollection
      match /links/{linkid} {
          allow get: if resource.data.isActive == true
                     || (request.auth != null && request.auth.uid == userid);
          allow list: if true;
          allow write: if request.auth != null && request.auth.uid == userid;

          // Allow anyone (including unauthenticated visitors) to increment
          // clickCount by exactly 1. The diff() check ensures no other field
          // can be touched through this rule — not title, url, isActive, etc.
          allow update: if
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']) &&
              request.resource.data.clickCount == resource.data.clickCount + 1;
      }
    }

    // Username reservation path tracking (Used by your auth layer).
    // Reservation docs are only ever create'd or delete'd — never mutated
    // in place. Rename flows always do delete(old) + create(new) inside a
    // transaction (see updateUsername in services/users.js), so allowing
    // create/delete but never update also blocks a would-be hijack where
    // someone updates an *existing* usernames/{x} doc to point at their own uid.
    match /usernames/{username} {
      allow read: if true;

      // Can only ever reserve a username for yourself, never on someone else's behalf.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;

      // Can only release your own reservation.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;

      allow update: if false;
    }

    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
    
    // match /{document=**} {
    //   allow read, write: if request.time < timestamp.date(2026, 7, 23);
    // }
        // Allows access to everything ELSE, but prevents hackers from bypassing the /users rules
    
    match /{document=**} {
      allow read, write: if request.auth != null 
                        && !request.path.to_string().contains('/documents/users/')
                        && !request.path.to_string().contains('/documents/usernames/')
                        && request.time < timestamp.date(2026, 7, 23);
    }
  }
}